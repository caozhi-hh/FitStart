    {
      "id": "muscle-breakfast-1",
      "name": "燕麦鸡蛋增肌早餐",
      "type": "muscle-gain",
      "meal": "breakfast",
      "description": "高蛋白碳水组合，为增肌训练提供充足能量和营养。",
      "ingredients": [
        {"name": "燕麦", "amount": "80g"},
        {"name": "鸡蛋", "amount": "2个"},
        {"name": "牛奶", "amount": "250ml"},
        {"name": "香蕉", "amount": "1根"},
        {"name": "坚果", "amount": "20g"}
      ],
      "steps": [
        "燕麦加入牛奶，微波炉加热2分钟或小火煮5分钟",
        "鸡蛋煮熟或煎熟（少油）",
        "香蕉切片，坚果切碎",
        "将香蕉和坚果撒在燕麦上",
        "搭配鸡蛋一起食用"
      ],
      "nutrition": {
        "calories": 650,
        "protein": 32,
        "carbs": 75,
        "fat": 22
      },
      "tips": "训练前1-2小时食用最佳，可以再加一勺蛋白粉",
      "imageUrl": "/images/recipes/oatmeal-breakfast.jpg"
    },
